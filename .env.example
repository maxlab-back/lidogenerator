# Скопируй в .env и при желании впиши ключи:  cp .env.example .env
#
# ПО УМОЛЧАНИЮ КЛЮЧИ НЕ НУЖНЫ — работает на DuckDuckGo (sources.search.backend: duckduckgo).
# Ключи нужны, только если хочешь стабильный/больший объём и переключаешь backend.

# --- Google Custom Search (backend: google_cse) — 100 запросов/день бесплатно ---
# Ключ: https://developers.google.com/custom-search/v1/introduction
# CX (идентификатор поисковика): https://programmablesearchengine.google.com/
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# --- serper.dev (backend: serper) — результаты Google, дёшево ---
# Ключ: https://serper.dev/
SERPER_API_KEY=

# --- Яндекс XML (backend: yandex_xml) ---
# ВНИМАНИЕ: бесплатный Яндекс.XML закрыт. Это для платного Yandex Search API
# или для реселлеров XML-лимитов (xmlstock.com и т.п.).
YANDEX_XML_USER=
YANDEX_XML_KEY=

# --- DaData (обогащение юр.данными, 10 000 запросов/день бесплатно) ---
# https://dadata.ru/ -> регистрация -> Профиль -> API-ключи -> "Ключ доступа к API"
DADATA_API_KEY=

# --- Apify (готовые парсеры 2ГИС/Яндекс.Карт, $5 бесплатно/мес) ---
# https://apify.com/ -> Settings -> Integrations -> API token
APIFY_TOKEN=

# ============ Универсальный режим (python app.py) ============

# --- Claude (ИИ-проверка сайтов, генерация запросов) ---
# https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=

# --- Яндекс Поиск API v2 (Yandex Cloud / AI Studio) ---
# API-ключ сервисного аккаунта с ролью search-api.webSearch.user + id каталога
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=

# --- CRM (достаточно одной) ---
# Битрикс24: Приложения -> Разработчикам -> Входящий вебхук с правом crm
BITRIX24_WEBHOOK=
# amoCRM: Настройки -> Интеграции -> Создать интеграцию -> долгосрочный токен
AMOCRM_HOST=
AMOCRM_TOKEN=

# --- Telegram-уведомления об автопоиске ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# адрес интерфейса для ссылки в уведомлении (если развёрнут на сервере)
APP_PUBLIC_URL=
